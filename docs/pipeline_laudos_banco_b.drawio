        <mxCell id="titulo" value="&lt;b&gt;Pipeline de laudos Banco B&lt;/b&gt; (Plataforma → banco de dados)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="orq" value="&lt;b&gt;rodar_pipeline.py&lt;/b&gt;&lt;br&gt;Roda as etapas 1 a 3 em sequência e dispara a 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=10;" vertex="1" parent="1">
