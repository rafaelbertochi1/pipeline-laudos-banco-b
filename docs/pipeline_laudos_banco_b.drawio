        </mxCell>

        <mxCell id="e1" value="&lt;b&gt;1. plataforma_downloader.py&lt;/b&gt;&lt;br&gt;Login automático na Plataforma (MFA)&lt;br&gt;Baixa os PDFs pela API, 12 ao mesmo tempo&lt;br&gt;Pula o que já foi baixado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="&lt;b&gt;2. banco_b_extractor.py&lt;/b&gt;&lt;br&gt;Lê os PDFs em paralelo e salva as fotos&lt;br&gt;Pula os que já estão no banco&lt;br&gt;Empreendimento inteiro fica fora" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="val" value="Lote passou&lt;br&gt;na validação?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="380" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="&lt;b&gt;3. banco_b_imagens.py&lt;/b&gt;&lt;br&gt;Fachada e cômodos pela regra atual&lt;br&gt;Foto errada vai pra _removidas&lt;br&gt;Só abre PDF ainda não verificado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=12;arcSize=8;" vertex="1" parent="1">
